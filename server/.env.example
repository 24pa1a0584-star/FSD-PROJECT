# ==============================================================================
# VISHNUFIT Server Environment Variables
# ==============================================================================

# Server Port (Render sets this dynamically; defaults to 5000 locally)
PORT=5000

# Environment Mode ('development' locally, 'production' on Render)
NODE_ENV=development

# Database Connection
# Local: mongodb://127.0.0.1:27017/vishnufit
# Render (MongoDB Atlas): mongodb+srv://<username>:<password>@<cluster-subdomain>.mongodb.net/vishnufit?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vishnufit

# JWT & Dynamic QR Token Secrets (generate a random 32+ character string in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_32_characters_long
QR_SECRET=replace_with_a_secure_random_qr_secret_key_32_characters_long

# Optional Frontend URL (Leave empty in production single-service mode for same-origin)
CLIENT_URL=http://localhost:5173

# ==============================================================================
# One-Time Safe Database Bootstrap (Enable on first setup, then disable)
# ==============================================================================
# Set to 'true' to run initial setup on server startup without deleting existing data
INITIAL_SETUP_ENABLED=false

# Super Admin Bootstrap (Created only if no Super Admin exists; never overwrites)
BOOTSTRAP_ADMIN_NAME=Super Administrator
BOOTSTRAP_ADMIN_EMAIL=superadmin@vishnu.edu.in
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisToAStrongPassword@123

# Optional Boys Gym Manager Bootstrap
BOOTSTRAP_BOYS_MANAGER_NAME=Boys Gym Manager
BOOTSTRAP_BOYS_MANAGER_EMAIL=manager.boys@vishnu.edu.in
BOOTSTRAP_BOYS_MANAGER_PASSWORD=ChangeThisToBoysManagerPassword@123

# Optional Girls Gym Manager Bootstrap
BOOTSTRAP_GIRLS_MANAGER_NAME=Girls Gym Manager
BOOTSTRAP_GIRLS_MANAGER_EMAIL=manager.girls@vishnu.edu.in
BOOTSTRAP_GIRLS_MANAGER_PASSWORD=ChangeThisToGirlsManagerPassword@123

