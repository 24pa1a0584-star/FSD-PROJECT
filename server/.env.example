# ==============================================================================
# VISHNUFIT Server Environment Variables
# ==============================================================================

# Server Port (Render sets this dynamically; defaults to 5000 locally)
PORT=5000

# Environment Mode ('development' locally, 'production' on Render)
NODE_ENV=development

# Database Connection
# Local: mongodb://127.0.0.1:27017/vishnufit
# Render (MongoDB Atlas): mongodb+srv://<username>:<password>@<cluster-subdomain>.mongodb.net/vishnufit?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vishnufit

# JWT & Dynamic QR Token Secrets (generate a random 32+ character string in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_32_characters_long
QR_SECRET=replace_with_a_secure_random_qr_secret_key_32_characters_long

# Optional Frontend URL (Leave empty in production single-service mode for same-origin)
CLIENT_URL=http://localhost:5173

