# ==============================================================================
# VISHNUFIT Render Single-Service Deployment Environment Variables
# Copy and configure these in Render Dashboard -> Web Service -> Environment
# ==============================================================================

# 1. Environment Mode (Required)
NODE_ENV=production

# 2. Server Port (Render sets this automatically; this fallback is for local testing)
PORT=10000

# 3. MongoDB Atlas Database Connection String (Required)
# Replace <username>, <password>, and <cluster-subdomain> with your Atlas cluster details.
# Ensure your database user has readWrite permissions and Network Access IP Whitelist has 0.0.0.0/0.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-subdomain>.mongodb.net/vishnufit?retryWrites=true&w=majority

# 4. Authentication Secrets (Required - Set strong random strings, e.g. 32+ characters)
JWT_SECRET=replace_with_a_long_random_jwt_secret_for_production_sessions
QR_SECRET=replace_with_a_long_random_qr_secret_for_dynamic_membership_tokens

# 5. Optional Flags
# Set to 'true' if you want the login page to show quick 1-click demo role buttons. Leave 'false' in production.
VITE_SHOW_DEMO_CREDS=false
