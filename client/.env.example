# ==============================================================================
# VISHNUFIT Client Environment Variables
# ==============================================================================

# In production single-service mode on Render, leave these empty or unset.
# The client automatically falls back to same-origin relative URLs (/api and window.location.origin).
VITE_API_URL=
VITE_SOCKET_URL=

# Show quick demo credentials on the login screen (true for testing, false in production)
VITE_SHOW_DEMO_CREDS=false

